# Admin token — protects the /admin panel and encrypts stored passwords (required)
VW_ADMIN_TOKEN=your-admin-token-here

# --- Legacy variables (auto-migrated on first start, can be removed after) ---
# BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BW_MASTER_PASSWORD=your-master-password-here

# --- Rate limiting (optional) ---
