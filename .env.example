# Vaultwarden admin panel token
VW_ADMIN_TOKEN=your-admin-token-here

# Bitwarden API Key (from Vaultwarden: Settings → Security → API Key)
BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vault master password (used to unlock vault on startup)
BW_MASTER_PASSWORD=your-master-password-here

# --- Security features (all optional) ---

# Bearer token for API authentication (leave empty to disable)
MCP_AUTH_TOKEN=

# Rate limiting
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_COOLDOWN_SECONDS=30
