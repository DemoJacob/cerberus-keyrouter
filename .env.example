# Vaultwarden admin panel token (you set this yourself)
VW_ADMIN_TOKEN=change-me-to-a-secure-random-string

# Bitwarden CLI API key (from Vaultwarden Web UI → Settings → Security → Keys → API Key)
BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Master password (the one you used to register in Vaultwarden)
BW_MASTER_PASSWORD=your-master-password

# Chrome CDP endpoint (default: http://127.0.0.1:18800)
CDP_URL=http://127.0.0.1:18800

# MCP server port (default: 8899)
MCP_PORT=8899

# Vaultwarden URL for bw CLI (default: https://localhost:8443)
BW_URL=https://localhost:8443
